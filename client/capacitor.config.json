{
  "appId": "id.ac.pasim.portal",
  "appName": "Portal Pasim",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "overrideUserAgent": "PortalPasimApp/1.0 (Android; Mobile)"
  },
  "server": {
    "url": "https://nondecayed-bodhi-bardier.ngrok-free.dev",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "nondecayed-bodhi-bardier.ngrok-free.dev",
      "*.ngrok-free.dev",
      "*.ngrok-free.app",
      "*.trycloudflare.com",
      "*.loca.lt",
      "192.168.*",
      "localhost",
      "10.0.2.2",
      "res.cloudinary.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f172a"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pasim",
      "iconColor": "#8B1E24"
    }
  }
}