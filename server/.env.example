# Server Configuration
NODE_ENV=development
PORT=5000
# Pisahkan dengan koma; mendukung pola wildcard seperti https://*.trycloudflare.com
CLIENT_URL=http://localhost:5173

# Database MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=db_portal_pasim
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true untuk cloud database seperti TiDB Cloud / Aiven
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=ganti_dengan_secret_acak_minimal_64_karakter_untuk_access_token
JWT_REFRESH_SECRET=ganti_dengan_secret_acak_minimal_64_karakter_untuk_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=portal-unas-pasim

# Keamanan Proxy & Auth
# TRUST_PROXY=1
# CORS_ALLOW_TUNNELS=true
# ENABLE_DEV_RESET_TOKEN_RESPONSE=false

# Perpustakaan Materi Upload Configuration
MAX_DOC_FILE_SIZE_MB=10
MAX_PHOTO_FILE_SIZE_MB=5

# SMTP / Nodemailer Configuration (Opsional - jika kosong otomatis log ke console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@pasim.ac.id
SMTP_PASS=your_app_password
SMTP_FROM="Portal Kampus UNAS PASIM <no-reply@pasim.ac.id>"

# Web Push VAPID Keys (Opsional di dev — buat lewat: npx web-push generate-vapid-keys atau openssl/node)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pasim.ac.id

# Fitur Poker Virtual Hiburan (tanpa uang asli)
FEATURE_POKER=true
POKER_MAX_ACTIVE_ROOMS=50
POKER_MAX_ROOMS_PER_USER_HOUR=10
